VITE_SUPABASE_URL=https://xddhhybyviuntnnymfbo.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_JKe-ceUqfUoogz0UkKsKOw_bvYtc92h

# Node API base.
#   Keep the VITE_ prefix — Vite ONLY injects import.meta.env.VITE_* vars into
#   the browser bundle. Dropping the prefix silently breaks the web->API link
#   (production deploy got burned by this). This value is inherently PUBLIC
#   (the browser needs it), so the "Remove public prefix" lint warning is a
#   false positive here — no secret is exposed by keeping it.
#   Local dev:   leave EMPTY → Vite proxies '/api' to http://localhost:8080
#   Vercel prod: set to your deployed API origin, e.g.
#                VITE_API_URL=https://your-api-app.vercel.app
VITE_API_URL=