# ---- server/.env (NEVER commit real values) ----
PORT=8080
# URL of your Supabase project
SUPABASE_URL=https://xddhhybyviuntnnymfbo.supabase.co
# ⚠ SERVICE ROLE key — bypasses RLS. Server-only, never ship to browser.
SUPABASE_SERVICE_ROLE_KEY=
# Publishable key (Settings→API) — same public-safe value as web/.env's
# VITE_SUPABASE_PUBLISHABLE_KEY. Required as the `apikey` header for the
# per-request user-token client (RLS-checked writes: progress, profile).
SUPABASE_PUBLISHABLE_KEY=sb_publishable_JKe-ceUqfUoogz0UkKsKOw_bvYtc92h
# Comma-separated browser origins allowed to call this API.
# Local:        http://localhost:5173
# Production:   the deployed Vercel web origin, e.g. https://your-web-app.vercel.app
CLIENT_ORIGIN=http://localhost:5173
# Shared secret for the bulk-import endpoint (ops automation)
ADMIN_IMPORT_SECRET=change-me-long-random-string
# Billing sandbox: no gateway calls, subscriptions activate instantly.
BILLING_PROVIDER=sandbox